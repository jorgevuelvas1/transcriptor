# =====================================================================
#  Credenciales para la generacion de voz (TTS)
# =====================================================================
#  Copia este archivo a `.env` y rellena UNA de las dos variables.
#  El pipeline elige proveedor por prioridad:
#     1) OPENAI_API_KEY   -> OpenAI Audio Speech API
#     2) GEMINI_API_KEY   -> Google Gemini API (TTS)
#
#  El script `npm run voice` consulta la API de modelos del proveedor
#  EN TIEMPO DE EJECUCION y selecciona un modelo TTS vigente, en vez de
#  depender de un identificador fijo que puede quedar obsoleto.
#
#  Las claves NUNCA se imprimen en consola ni se escriben en logs.
# =====================================================================

OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Opcionales -------------------------------------------------------
# Voz preferida. Si se deja vacio se usa el valor por defecto del
# proveedor definido en scripts/generateVoice.ts (voz masculina).
# TTS_VOICE=

# Fuerza un proveedor concreto: "openai" | "gemini"
# TTS_PROVIDER=
